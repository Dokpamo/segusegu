<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Lorepia.Native.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lorepia.Native\Lorepia.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="..\Lorepia.App\Platform\BoundedStreamCopier.cs"
      Link="AppLogic\BoundedStreamCopier.cs" />
    <Compile
      Include="..\Lorepia.App\Platform\PasswordVaultError.cs"
      Link="AppLogic\PasswordVaultError.cs" />
    <Compile
      Include="..\Lorepia.App\ViewModels\GenerationEventCursor.cs"
      Link="AppLogic\GenerationEventCursor.cs" />
    <Compile
      Include="..\Lorepia.App\ViewModels\ObservableObject.cs"
      Link="AppLogic\ObservableObject.cs" />
    <Compile
      Include="..\Lorepia.App\ViewModels\ShellNavigationModel.cs"
      Link="AppLogic\ShellNavigationModel.cs" />
    <Compile
      Include="..\Lorepia.App\ViewModels\ShellViewModel.cs"
      Link="AppLogic\ShellViewModel.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(LorepiaNativeDllPath)' != '' and Exists('$(LorepiaNativeDllPath)')">
    <None
      Include="$(LorepiaNativeDllPath)"
      Link="lorepia_core.dll"
      CopyToOutputDirectory="PreserveNewest"
      Visible="false" />
  </ItemGroup>

  <Target Name="ValidateLorepiaNativeDll" BeforeTargets="Build">
    <Error
      Condition="'$(RequireLorepiaNativeDll)' == 'true' and '$(LorepiaNativeDllPath)' == ''"
      Text="LorepiaNativeDllPath is required for live native tests." />
    <Error
      Condition="'$(RequireLorepiaNativeDll)' == 'true' and !Exists('$(LorepiaNativeDllPath)')"
      Text="LorePia native DLL not found at '$(LorepiaNativeDllPath)'." />
  </Target>
</Project>
