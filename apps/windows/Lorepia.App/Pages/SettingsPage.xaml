<Page
    x:Class="Lorepia.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Padding="32"
            Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Settings" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Native core diagnostics"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid
                ColumnSpacing="24"
                RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="C ABI version" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.AbiVersion, Mode=OneWay}" />

                <TextBlock Grid.Row="1" Text="Core version" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.CoreVersion, Mode=OneWay}" />

                <TextBlock Grid.Row="2" Text="Database" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.Database, Mode=OneWay}" />

                <TextBlock Grid.Row="3" Text="Data root" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.DataRoot, Mode=OneWay}" />

                <TextBlock Grid.Row="4" Text="Staging" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.Staging, Mode=OneWay}" />

                <TextBlock Grid.Row="5" Text="Recovery" />
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.Recovery, Mode=OneWay}" />
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.Status, Mode=OneWay}"
                Severity="Informational"
                Title="Core health" />

            <Button
                Click="Refresh_Click"
                Content="Refresh health check"
                HorizontalAlignment="Left" />
            <ProgressRing
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
