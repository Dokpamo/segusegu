<Page
    x:Class="Lorepia.App.Pages.ImportReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Padding="32"
            Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Import review" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Windows selects and stages the file. Rust owns package inspection and final storage."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="30"
                        Glyph="&#xE8B7;"
                        VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.SelectedFileName, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.SelectedFileSize, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.SelectedFilePath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ReviewStatus, Mode=OneWay}"
                Severity="Informational"
                Title="Import boundary" />

            <ProgressRing
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="ChooseFile_Click"
                    Content="Choose file"
                    IsEnabled="{x:Bind ViewModel.CanChooseFile, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Click="Cancel_Click"
                    Content="Discard review" />
                <Button
                    Click="Approve_Click"
                    Content="Approve import"
                    IsEnabled="{x:Bind ViewModel.CanApprove, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="24" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Name" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="Description" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="Content kind" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ContentKind, Mode=OneWay}" />
                <TextBlock Grid.Row="3" Text="Stored size estimate" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.StorageEstimate, Mode=OneWay}" />
                <TextBlock Grid.Row="4" Text="Warnings" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.Warnings, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="5" Text="Blocked reasons" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.BlockedReasons, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="6" Text="Representative image" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.RepresentativeImage, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="7" Text="Unsupported optional fields" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.UnsupportedOptionalFields, Mode=OneWay}" TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
