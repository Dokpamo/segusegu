<Page
    x:Class="Lorepia.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:native="using:Lorepia.Native"
    Loaded="Page_Loaded">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="Library" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
            <ProgressRing
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ListView
                IsItemClickEnabled="True"
                ItemClick="Character_ItemClick"
                Margin="0,24,0,0"
                ItemsSource="{x:Bind ViewModel.Characters}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="native:CharacterSummary">
                        <StackPanel Padding="12" Spacing="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Name}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420"
                Spacing="12"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="42"
                    Glyph="&#xE8F1;" />
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Text="{x:Bind ViewModel.EmptyStateTitle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyStateDescription}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Click="ReviewImport_Click"
                    Content="Review an import"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
